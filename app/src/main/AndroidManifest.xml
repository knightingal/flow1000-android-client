<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- <uses-permission android:name="android.permission.INTERNET" /> -->
    <uses-permission
            android:name="android.permission.READ_MEDIA_IMAGES"/> <!-- Include next permission if you want to allow UIL to cache images on SD card -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <uses-feature android:name="android.hardware.camera"/>
    <uses-feature android:name="android.hardware.camera.autofocus"/>

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FLASHLIGHT"/>

    <application
            android:name=".myapplication.App"
            android:allowBackup="true"
            android:icon="@drawable/app_icon"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/AppTheme"
            android:usesCleartextTraffic="true">
        <activity
                android:name=".myapplication.EmptyActivity"
                android:exported="false"
                android:label="@string/title_activity_empty"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".myapplication.ExistSectionGridPage"
                android:exported="true"
                android:label="@string/title_activity_tab_main"
                android:icon="@drawable/app_icon"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".myapplication.TabMainActivity"
                android:exported="true"
                android:label="@string/title_activity_tab_main"
                android:icon="@drawable/app_icon"
                android:theme="@style/AppTheme">

<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN"/>-->

<!--                <category android:name="android.intent.category.LAUNCHER"/>-->
<!--            </intent-filter>-->
        </activity>
        <activity
                android:name=".myapplication.MainActivity"
                android:exported="true"
                android:icon="@drawable/app_icon"
                android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
                android:name=".myapplication.SectionImageListActivity"
                android:label="@string/title_activity_list"/>
        <activity
                android:name=".myapplication.PicContentActivity"
                android:label="@string/title_activity_xrx"
                android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen"/>
        <activity
                android:name=".myapplication.AboutActivity"
                android:exported="true"
                android:label="@string/title_activity_setting"/>
        <activity
                android:name=".myapplication.StableDiffusionRepoActivity"
                android:label="@string/title_activity_stable_diffusion_repo"/>

        <service
                android:name=".services.DownloadService"
                android:enabled="true"
                />

        <activity
                android:name=".myapplication.PicSectionListActivity"
                android:label="@string/title_activity_pic_section_list_activity_md"/>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="com.example.flow1000client.debug.file_provider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>